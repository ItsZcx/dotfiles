alias la='ls -a'
alias python='python3'
alias c='clear'

# Open the file manager / default handler for a path.
# macOS ships a native 'open', Linux commonly uses xdg-open.
if [ "${sys_family}" = "macos" ]; then
  # Native 'open' is present on macOS and needs no alias. Bear in mind:
  #   open .         -> reveal current dir in Finder
  #   open somefile  -> open with the default app for that file
  :
else
  if command -v xdg-open >/dev/null 2>&1; then
    alias open='xdg-open .'
  fi
fi

# Purge __pycache__ directories below the current folder.
alias prm='sudo find ${PWD} -maxdepth 20 -type d -name __pycache__ -exec rm -r {} +'


