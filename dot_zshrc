###########
## System / Package-manager handling ##
###########

# Coarse detection of the running family. Not a brittle version string:
# we key package-manager decisions off a single variable set here.
case "$(uname -s)" in
  Darwin) sys_family="macos" ;;
  Linux)  sys_family="linux" ;;
  *)      sys_family="unknown" ;;
esac

# 'update' refreshes system packages using whichever manager is present.
# Priority: Homebrew (brew) > apt, decided by what's actually installed.
update() {
  if command -v brew >/dev/null 2>&1; then
    brew update && brew upgrade
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y
  fi
}

# APT-specific hygiene only where apt is in use.
if command -v apt-get >/dev/null 2>&1; then
  alias aptclean='sudo apt-get clean && sudo apt-get autoclean'
fi

