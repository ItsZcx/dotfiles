# Prepend tool directories to the PATH.
#
# Each candidate is added only if its directory exists. We build through
# zsh's 'path' array (the array view of $PATH) with the unique flag set, so
# re-sourcing never creates duplicates. Priority order (first wins):
#   ~/.local/share/pi-node/current/bin   pi + its bundled node/npm/npx
#   ~/.local/bin                         pip --user, chezmoi, zoxide, uv
#   /usr/local/bin                       system-local
# Homebrew's prefix is prepended first when brew exists (macOS / linuxbrew).
typeset -U path
typeset -a _tools
for _dir in \
  "$HOME/.local/share/pi-node/current/bin" \
  "$HOME/.local/bin" \
  "/usr/local/bin"; do
  [[ -d "$_dir" ]] && _tools+=("$_dir")
done

# ---------------------------------------------------------------------------
# Pi coding agent — make the config dir explicit for pi-web-access
# ---------------------------------------------------------------------------
# pi-web-access (the web_search extension) reads its config from here. Pointing
# PI_CODING_AGENT_DIR at pi's own agent dir is harmless and keeps web_search
# config next to the rest of pi's config. The TinyFish search key is stored in
# ~/.pi/agent/web-search.json (empty until you paste one), NOT here or in the
# chezmoi repo.
export PI_CODING_AGENT_DIR="$HOME/.pi/agent"
if command -v brew >/dev/null 2>&1; then
  _tools=("$(brew --prefix)/bin" "$(brew --prefix)/opt/nvim/bin" "${_tools[@]}")
fi
path=("${_tools[@]}" "${path[@]}")
unset _dir _tools

# Zoxide (Only load if installed)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init --cmd cd zsh)"
fi

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Zsh functions
fpath+=~/.zfunc
autoload -Uz compinit && compinit
